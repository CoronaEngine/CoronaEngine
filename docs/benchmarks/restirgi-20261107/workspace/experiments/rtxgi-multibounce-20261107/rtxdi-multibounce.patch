--- a/Samples/FullSample/Shaders/LightingPasses/BenchmarkPathTrace.hlsli
+++ b/Samples/FullSample/Shaders/LightingPasses/BenchmarkPathTrace.hlsli
@@ -0,0 +1,168 @@
+#ifndef BENCHMARK_PATH_TRACE_HLSLI
+#define BENCHMARK_PATH_TRACE_HLSLI
+
+// Application-only transport extension. ReSTIR GI continues to reconnect the
+// first secondary vertex; its outgoing radiance contains this entire path tail.
+// Physical surface depths include the primary as 1. Corona min_depth=5 is
+// zero-based, so the first roulette test follows surface 6.
+static const uint kBenchmarkMaxSurfaceDepth = 16;
+static const uint kBenchmarkFirstRRSurfaceDepth = 6;
+static const float kBenchmarkAlbedo = 0.7;
+
+struct BenchmarkPathResult
+{
+    float3 radiance;
+    uint lastDepth;
+    uint rrTests;
+    uint rrSurvivals;
+    uint reason; // 0 invalid primary, 1 miss, 2 roulette, 3 terminal depth
+};
+
+bool BenchmarkTraceNextSurface(RAB_Surface surface, inout RTXDI_RandomSamplerState rng, out RAB_Surface nextSurface)
+{
+    float3 tangent, bitangent;
+    BranchlessONB(surface.normal, tangent, bitangent);
+    float unusedPdf;
+    float2 random = float2(RTXDI_GetNextRandom(rng), RTXDI_GetNextRandom(rng));
+    float3 localDirection = SampleCosHemisphere(random, unusedPdf);
+
+    RayDesc ray;
+    ray.Origin = BenchmarkOffsetRayOrigin(surface.worldPos, surface.geoNormal);
+    ray.Direction = tangent * localDirection.x + bitangent * localDirection.y + surface.normal * localDirection.z;
+    ray.TMin = 0;
+    ray.TMax = 1000;
+
+    RAB_RayPayload payload = (RAB_RayPayload)0;
+    payload.instanceID = ~0u;
+    payload.throughput = 1;
+#if USE_RAY_QUERY
+    RayQuery<RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> rayQuery;
+    rayQuery.TraceRayInline(SceneBVH, RAY_FLAG_NONE, INSTANCE_MASK_OPAQUE, ray);
+    while (rayQuery.Proceed()) { }
+    if (rayQuery.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
+    {
+        payload.instanceID = rayQuery.CommittedInstanceID();
+        payload.geometryIndex = rayQuery.CommittedGeometryIndex();
+        payload.primitiveIndex = rayQuery.CommittedPrimitiveIndex();
+        payload.barycentrics = rayQuery.CommittedTriangleBarycentrics();
+        payload.committedRayT = rayQuery.CommittedRayT();
+    }
+#else
+    TraceRay(SceneBVH, RAY_FLAG_NONE, INSTANCE_MASK_OPAQUE, 0, 0, 0, ray, payload);
+#endif
+    nextSurface = RAB_EmptySurface();
+    if (payload.instanceID == ~0u)
+        return false;
+
+    GeometrySample gs = getGeometryFromHit(payload.instanceID, payload.geometryIndex,
+        payload.primitiveIndex, payload.barycentrics, GeomAttr_Normal | GeomAttr_Position,
+        t_InstanceData, t_GeometryData, t_MaterialConstants);
+    nextSurface.worldPos = ray.Origin + ray.Direction * payload.committedRayT;
+    nextSurface.normal = dot(gs.flatNormal, ray.Direction) < 0 ? gs.flatNormal : -gs.flatNormal;
+    nextSurface.geoNormal = nextSurface.normal;
+    nextSurface.viewDir = -ray.Direction;
+    nextSurface.viewDepth = 1;
+    nextSurface.diffuseProbability = 1;
+    nextSurface.material.diffuseAlbedo = kBenchmarkAlbedo;
+    nextSurface.material.specularF0 = 0;
+    nextSurface.material.roughness = 1;
+    return true;
+}
+
+float3 BenchmarkSampleSun(RAB_Surface surface, inout RTXDI_RandomSamplerState rng,
+    inout RTXDI_RandomSamplerState tileRng)
+{
+    // Keep the native secondary-light candidate path, including its hard-sun
+    // PolymorphicLight conversion and discrete probability mass of one.
+    RAB_LightSample lightSample;
+    RTXDI_DIReservoir reservoir = RTXDI_SampleLightsForSurface(rng, tileRng, surface,
+        g_Const.brdfPT.secondarySurfaceReSTIRDIParams.initialSamplingParams, g_Const.lightBufferParams,
+#if RTXDI_ENABLE_PRESAMPLING
+        g_Const.localLightsRISBufferSegmentParams, g_Const.environmentLightRISBufferSegmentParams,
+#if RTXDI_REGIR_MODE != RTXDI_REGIR_MODE_DISABLED
+        g_Const.regir,
+#endif
+#endif
+        lightSample);
+    float3 diffuse = 0;
+    float3 specular = 0;
+    float lightDistance = 0;
+    ShadeSurfaceWithLightSample(reservoir, surface, g_Const.restirDI.shadingParams, lightSample,
+        false, false, false, diffuse, specular, lightDistance);
+    return diffuse * kBenchmarkAlbedo;
+}
+
+BenchmarkPathResult BenchmarkTraceTail(RAB_Surface secondarySurface, bool validSecondary,
+    inout RTXDI_RandomSamplerState rng, inout RTXDI_RandomSamplerState tileRng)
+{
+    BenchmarkPathResult result = (BenchmarkPathResult)0;
+    result.lastDepth = 1;
+    result.reason = 1;
+    if (!validSecondary)
+        return result;
+
+    RAB_Surface surface = secondarySurface;
+    float betaCamera = kBenchmarkAlbedo; // primary cosine-BSDF sampling weight
+    float tailWeight = 1;
+    [loop]
+    for (uint depth = 2; depth <= kBenchmarkMaxSurfaceDepth; ++depth)
+    {
+        result.lastDepth = depth;
+        result.radiance += tailWeight * BenchmarkSampleSun(surface, rng, tileRng);
+        if (depth == kBenchmarkMaxSurfaceDepth)
+        {
+            result.reason = 3;
+            break;
+        }
+
+        const float betaBeforeCurrentBSDF = betaCamera;
+        betaCamera *= kBenchmarkAlbedo;
+        tailWeight *= kBenchmarkAlbedo;
+        if (depth >= kBenchmarkFirstRRSurfaceDepth && betaBeforeCurrentBSDF < 1)
+        {
+            ++result.rrTests;
+            const float survival = min(0.95, betaBeforeCurrentBSDF);
+            if (RTXDI_GetNextRandom(rng) > survival)
+            {
+                result.reason = 2;
+                break;
+            }
+            ++result.rrSurvivals;
+            betaCamera /= survival;
+            tailWeight /= survival;
+        }
+
+        RAB_Surface nextSurface;
+        if (!BenchmarkTraceNextSurface(surface, rng, nextSurface))
+        {
+            result.reason = 1;
+            break;
+        }
+        surface = nextSurface;
+    }
+    return result;
+}
+
+BenchmarkPathResult BenchmarkTraceFresh(RAB_Surface primarySurface, uint2 globalIndex)
+{
+    BenchmarkPathResult result = (BenchmarkPathResult)0;
+    if (!RAB_IsSurfaceValid(primarySurface))
+        return result;
+    // Separate from initial GI candidate generation and all reuse/packing.
+    RTXDI_RandomSamplerState rng = RTXDI_InitRandomSampler(globalIndex,
+        g_Const.runtimeParams.frameIndex, 0x4d425046u);
+    RTXDI_RandomSamplerState tileRng = RTXDI_InitRandomSampler(globalIndex / RTXDI_TILE_SIZE_IN_PIXELS,
+        g_Const.runtimeParams.frameIndex, 0x4d425054u);
+    RAB_Surface secondarySurface;
+    bool validSecondary = BenchmarkTraceNextSurface(primarySurface, rng, secondarySurface);
+    result = BenchmarkTraceTail(secondarySurface, validSecondary, rng, tileRng);
+    result.radiance *= kBenchmarkAlbedo;
+    return result;
+}
+
+float4 BenchmarkPathStats(BenchmarkPathResult result)
+{
+    return float4(result.lastDepth, result.rrTests, result.rrSurvivals, result.reason);
+}
+
+#endif
