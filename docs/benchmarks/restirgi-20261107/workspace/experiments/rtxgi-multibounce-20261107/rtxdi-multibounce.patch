+static Json::Value SummarizeBenchmarkPathStats(const std::vector<float>& data)
+{
+    uint64_t depthHistogram[17] = {};
+    uint64_t reasonHistogram[4] = {};
+    uint64_t rrTests = 0, rrSurvivals = 0, invalidRecords = 0, prematureRR = 0;
+    for (size_t i = 0; i < data.size(); i += 4)
+    {
+        const int depth = int(data[i]);
+        const int tests = int(data[i + 1]);
+        const int survivals = int(data[i + 2]);
+        const int reason = int(data[i + 3]);
+        if (depth < 0 || depth > 16 || reason < 0 || reason > 3 || tests < 0 || survivals < 0 || survivals > tests)
+        {
+            ++invalidRecords;
+            continue;
+        }
+        ++depthHistogram[depth];
+        ++reasonHistogram[reason];
+        rrTests += uint64_t(tests);
+        rrSurvivals += uint64_t(survivals);
+        if (depth < 6 && tests > 0) ++prematureRR;
+    }
+    Json::Value result(Json::objectValue);
+    result["pixels"] = Json::UInt64(data.size() / 4);
+    for (auto count : depthHistogram) result["last_depth_histogram"].append(Json::UInt64(count));
+    for (auto count : reasonHistogram) result["termination_histogram"].append(Json::UInt64(count));
+    result["termination_labels"] = "0 invalid primary, 1 miss, 2 RR, 3 max16";
+    result["RR_tests"] = Json::UInt64(rrTests);
+    result["RR_survivals"] = Json::UInt64(rrSurvivals);
+    result["invalid_records"] = Json::UInt64(invalidRecords);
+    result["RR_before_surface6"] = Json::UInt64(prematureRR);
+    return result;
+}
