+#ifndef BENCHMARK_MULTIBOUNCE_HLSL
+#define BENCHMARK_MULTIBOUNCE_HLSL
+uint benchmark_source_pixel(float3 origin) {
+    float3 clip = position_world_to_sample(origin);
+    uint2 pixel = uint2(clamp(floor(cs_to_uv(clip.xy) * gbuffer_tex_size.xy), 0.0.xx, gbuffer_tex_size.xy - 1));
+    return pixel.x | (pixel.y << 16);
+}
+uint benchmark_replay_seed(uint2 source_pixel, float3 normal, float3 direction) {
+    // Native blue-noise proposals use 8-bit centers. Recover the discrete draw
+    // so validation can retrace its suffix without adding reservoir state.
+    float3 local = mul(direction, build_orthonormal_basis(normalize(normal)));
+    float phi = frac(atan2(local.y, local.x) / M_TAU + 1.0);
+    uint2 draw = uint2(clamp(floor(float2(1.0 - local.z, phi) * 256.0), 0.0.xx, 255.0.xx));
+    return hash3(uint3(source_pixel, draw.x | (draw.y << 8))) ^ 0x91e10da5u;
+}
+float2 benchmark_random2(inout uint rng) {
+    return float2(uint_to_u01_float(hash1_mut(rng)), uint_to_u01_float(hash1_mut(rng)));
+}
+float3 benchmark_cosine_direction(float3 normal, inout uint rng) {
+    float2 u = benchmark_random2(rng);
+    float r = sqrt(u.x), phi = M_TAU * u.y;
+    return normalize(mul(build_orthonormal_basis(normal), float3(r * cos(phi), r * sin(phi), sqrt(1.0 - u.x))));
+}
