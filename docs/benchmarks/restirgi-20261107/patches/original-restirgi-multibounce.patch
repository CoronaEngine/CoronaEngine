+[shader("raygeneration")]
+void RtdgiTraceRgen() {
+    uint2 px = DispatchRaysIndex().xy;
+    float2 uv = get_uv(px, gbuffer_tex_size);
+    if (frame_constants.benchmark_reference != 0) {
+        // Independent camera-primary and uncompressed geometric normals;
+        // no native GBuffer, FP16 radiance or reservoir read.
+        ViewRayContext view = ViewRayContext::from_uv(uv);
+        RayDesc camera_ray = new_ray(get_eye_position(), view.ray_dir_ws(), 0.0, SKY_DIST);
+        GbufferPathVertex primary = GbufferRaytrace::with_ray(camera_ray).with_cull_back_faces(false).trace(acceleration_structure);
+        if (!primary.is_hit) { benchmark_store(px, 0.0.xxx, 0.0.xxxx, false); return; }
+        float3 normal = normalize(primary.geometric_normal);
+        uint rng = hash3(uint3(px, frame_constants.frame_index)) ^ 0xa511e9b3u;
+        float3 direction = normalize(mul(build_orthonormal_basis(normal), uniform_sample_hemisphere(benchmark_random2(rng))));
+        RayDesc ray = new_ray(primary.position + normal * 1e-4, direction, 0, SKY_DIST);
+        TraceResult result = do_the_thing(px, normal, rng, ray);
+        benchmark_store(px, result.out_value * (1.4 * max(0.0, dot(normal, direction))), result.diagnostics, true);
+        candidate_irradiance_out_tex[px] = 0;
+        candidate_hit_out_tex[px] = 0;
+        candidate_normal_out_tex[px] = 0;
+        rt_history_invalidity_out_tex[px] = 0;
+        return;
+    }
+    float depth = depth_tex[px];
+    if (depth == 0.0) {
+        candidate_irradiance_out_tex[px] = 0;
+        candidate_normal_out_tex[px] = float4(0, 0, 1, 0);
+        candidate_hit_out_tex[px] = 0;
+        rt_history_invalidity_out_tex[px] = 0;
+        benchmark_store(px, 0.0.xxx, 0.0.xxxx, false);
+        return;
+    }
+    ViewRayContext view = ViewRayContext::from_uv_and_biased_depth(uv, depth);
+    float3 normal = normalize(direction_view_to_world(gi_view_normal_tex[px]));
+    float3 direction = normalize(rtdgi_candidate_ray_dir(px, build_orthonormal_basis(normal)));
+    RayDesc ray = new_ray(view.biased_secondary_ray_origin_ws_with_normal(normal), direction, 0, SKY_DIST);
+    uint rng = benchmark_replay_seed(px, normal, direction);
+    TraceResult result = do_the_thing(px, normal, rng, ray);
+    float cos_theta = dot(normalize(direction - view.ray_dir_ws()), normal);
+    candidate_irradiance_out_tex[px] = float4(result.out_value, rtr_encode_cos_theta_for_fp16(cos_theta));
+    candidate_hit_out_tex[px] = float4(direction * result.hit_t, result.pdf);
+    candidate_normal_out_tex[px] = float4(direction_world_to_view(result.hit_normal_ws), 0);
+    rt_history_invalidity_out_tex[px] = rt_history_invalidity_in_tex[px];
+    benchmark_store(px, result.out_value * (1.4 * max(0.0, dot(normal, direction))), result.diagnostics, true);
+}
