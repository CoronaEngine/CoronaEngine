+void benchmark_store(uint2 px, float3 radiance, float4 diagnostics, bool valid) {
+    if (frame_constants.benchmark_capture == 0) return;
+    float4 value = float4(radiance, valid ? 1.0 : 0.0);
+    benchmark_fresh[px] = value;
+    benchmark_sum[px] = frame_constants.benchmark_frame == 0 ? value : benchmark_sum[px] + value;
+    benchmark_depth[px] = diagnostics;
