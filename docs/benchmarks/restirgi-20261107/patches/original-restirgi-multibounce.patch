+float3 sample_environment_light(float3 dir) { return 0.0.xxx; }
+uint2 reservoir_payload_to_px(uint payload) { return uint2(payload & 0xffff, payload >> 16); }
+struct TraceResult {
+    float3 out_value;
+    float3 hit_normal_ws;
+    float hit_t;
+    float pdf;
+    bool is_hit;
+    float4 diagnostics; // last surface, RR tests, RR survivals, reason
+};
+TraceResult do_the_thing(uint2 px, float3 primary_normal, inout uint rng, RayDesc outgoing_ray) {
+    TraceResult result;
+    result.out_value = 0;
+    result.hit_normal_ws = -outgoing_ray.Direction;
+    result.hit_t = SKY_DIST;
+    result.pdf = rcp(max(1e-20, dot(primary_normal, outgoing_ray.Direction)) * 2.0 * M_PI);
+    result.is_hit = false;
+    result.diagnostics = float4(1, 0, 0, 1);
+    // Uniform primary proposal rho*cos/(pdf*pi)=1.4*cos. True camera beta is
+    // distinct from outgoing Lo at the stored first secondary vertex.
+    float camera_beta = 1.4 * max(0.0, dot(primary_normal, outgoing_ray.Direction));
+    float suffix_beta = 1.0;
+    RayDesc ray = outgoing_ray;
+    [loop] for (uint surface = 2; surface <= frame_constants.benchmark_max_depth; ++surface) {
+        GbufferPathVertex hit = GbufferRaytrace::with_ray(ray).with_cull_back_faces(false).with_path_length(surface - 1).trace(acceleration_structure);
+        if (!hit.is_hit) { result.diagnostics.w = 1; break; }
+        float3 normal = normalize(hit.geometric_normal);
+        result.diagnostics.x = surface;
+        if (surface == 2) {
+            result.is_hit = true;
+            result.hit_t = hit.ray_t;
+            result.hit_normal_ws = normal;
+        }
+        float sun_cosine = max(0.0, dot(normal, SUN_DIRECTION));
+        if (sun_cosine > 0.0 && !rt_is_shadowed(acceleration_structure, new_ray(hit.position, SUN_DIRECTION, 1e-4, SKY_DIST))) {
+            result.out_value += suffix_beta * (0.7 / M_PI) * sun_cosine * SUN_COLOR;
+        }
+        // Surface16 contributes NEE then ends before a17th ray or terminal RR.
+        if (surface == frame_constants.benchmark_max_depth) { result.diagnostics.w = 3; break; }
+        float probability = 1.0;
+        // Corona min_depth5 is zero-based: first test after surface6.
+        if (surface >= frame_constants.benchmark_min_depth + 1 && camera_beta < 1.0) {
+            result.diagnostics.y += 1;
+            probability = min(0.95, camera_beta);
+            if (uint_to_u01_float(hash1_mut(rng)) >= probability) { result.diagnostics.w = 2; break; }
+            result.diagnostics.z += 1;
+        }
+        suffix_beta *= 0.7 / probability;
+        camera_beta *= 0.7 / probability;
+        ray = new_ray(hit.position + normal * 1e-4, benchmark_cosine_direction(normal, rng), 0.0, SKY_DIST);
+    }
+    return result;
+}
