--- /dev/null
+++ b/Rtxpt/MainLoopWall.h
@@ -0,0 +1,79 @@
+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <stdexcept>
+#include <vector>
+
+// Host timestamps only. No queue synchronization or frame pacing is added.
+namespace MainLoopWall {
+enum Mark { AnimateBegin, AnimateEnd, RenderBegin, RenderEnd, PresentBegin, PresentEnd };
+struct Row {
+    uint64_t frame{};
+    uint32_t deviceFrame{};
+    int64_t start{}, end{};
+    double wall{}, animate{}, beginFrame{}, render{}, present{}, other{}, interval{};
+};
+inline Row current;
+inline std::array<int64_t, 6> marks{};
+inline std::vector<Row> rows;
+inline int64_t previousStart{};
+inline bool enabled() {
+    const char* value = std::getenv("RESTIR_MAINLOOP_WALL");
+    return value && value[0] == '1';
+}
+inline int64_t now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+inline double milliseconds(int64_t duration) { return double(duration) / 1000000.; }
+inline void begin(uint64_t frame, uint32_t deviceFrame) {
+    const int64_t tick = now();
+    current = {};
+    current.frame = frame;
+    current.deviceFrame = deviceFrame;
+    current.start = tick;
+    marks.fill(0);
+}
+inline void mark(Mark stage) { marks[size_t(stage)] = now(); }
+inline void write(const char* output, uint64_t target) {
+    std::ofstream file(std::filesystem::path(output) / "mainloop.csv");
+    if (!file) throw std::runtime_error("Cannot export main-loop wall timestamps");
+    file << "frame,device_frame,loop_start_ns,loop_end_ns,wall_ms,animate_host_ms,beginframe_gap_host_ms,render_host_ms,present_host_ms,other_host_ms,start_interval_ms\n";
+    file << std::setprecision(12);
+    for (const auto& r : rows)
+        file << r.frame << ',' << r.deviceFrame << ',' << r.start << ',' << r.end << ',' << r.wall << ','
+             << r.animate << ',' << r.beginFrame << ',' << r.render << ',' << r.present << ',' << r.other << ',' << r.interval << '\n';
+    std::ofstream meta(std::filesystem::path(output) / "mainloop-meta.json");
+    meta << "{\"clock\":\"std::chrono::steady_clock converted to nanoseconds\",\"is_steady\":"
+         << (std::chrono::steady_clock::is_steady ? "true" : "false")
+         << ",\"tick_frequency_hz\":1000000000,\"frame_target\":" << target
+         << ",\"complete_loop_rows\":" << rows.size()
+         << ",\"terminal_incomplete_frame_excluded\":" << target - 1
+         << ",\"csv_write_only_in_unmeasured_tail\":true,\"added_gpu_wait\":false,\"added_frame_pacing\":false,"
+            "\"boundary\":\"before outer-loop Streamline/input polling to after AnimateRenderPresent including Present, garbage collection and frame bookkeeping\","
+            "\"semantics\":\"normal pipelined main-loop wall time, not isolated same-frame GPU completion latency\"}\n";
+}
+inline void end(uint64_t benchmarkFrameAfter, bool success, const char* output, uint64_t target) {
+    const int64_t tick = now();
+    if (!success || benchmarkFrameAfter != current.frame + 1) return;
+    for (auto value : marks) if (value == 0) return;
+    current.end = tick;
+    current.wall = milliseconds(tick - current.start);
+    current.animate = milliseconds(marks[AnimateEnd] - marks[AnimateBegin]);
+    current.beginFrame = milliseconds(marks[RenderBegin] - marks[AnimateEnd]);
+    current.render = milliseconds(marks[RenderEnd] - marks[RenderBegin]);
+    current.present = milliseconds(marks[PresentEnd] - marks[PresentBegin]);
+    current.other = current.wall - current.animate - current.beginFrame - current.render - current.present;
+    current.interval = previousStart ? milliseconds(current.start - previousStart) : 0.;
+    previousStart = current.start;
+    rows.push_back(current);
+    // The app exits inside its last Render call. Export beforehand, after the
+    // measured window, so every reported loop includes Present and collection.
+    if (benchmarkFrameAfter + 1 == target) write(output, target);
+}
+}
