# Copy this file to .env and fill in the values locally.
# editor/.env is ignored by git and must never be committed.

# LLM providers. The provider name is normalized in CORONA_<NAME>_API_KEY.
CORONA_OPENAI_API_KEY=
CORONA_DEEPSEEK_API_KEY=
CORONA_DASHSCOPE_API_KEY=

# Common provider aliases also supported by the AITool.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Specialized AITool services.
CORONA_HUNYUAN3D_API_KEY=
SUNO_API_KEY=
