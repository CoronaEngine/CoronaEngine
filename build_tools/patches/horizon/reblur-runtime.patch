+// Match REBLUR's 832-byte constants, 28 flattened image descriptors and
+// remaining POD/buffer arguments without loading an engine or GPU module.
+void append_mixed_arguments(ShaderArgumentPack &pack) {
+    std::array<uint4, 52u> constants;
+    constants.fill(make_uint4(23u));
+    pack << constants;
+    for (uint image = 0u; image < 28u; ++image)
+        pack << uint64_t(image + 1u) << uint64_t(image + 2u) << make_uint2(1920u, 1080u);
+    static const BufferDesc<> descriptor{};
+    for (uint buffer = 0u; buffer < 15u; ++buffer) pack << descriptor;
+    pack << make_uint2(1920u, 1080u) << 3u << 1u << 0u;
+    pack << make_float4x4(1.f) << make_float4x4(1.f);
+    pack << std::array<float, 3u>{1.f, 2.f, 3.f} << std::array<float, 3u>{4.f, 5.f, 6.f};
+    for (uint scalar = 0u; scalar < 17u; ++scalar) pack << float(scalar);
+    pack << 1u << make_float4(2.f);
+    for (uint flag = 0u; flag < 5u; ++flag) pack << flag;
+}
+
+[[nodiscard]] bool test_mixed_arguments_and_large_overflow() {
+    Function function(Function::Tag::KERNEL);
+    ShaderArgumentPack mixed(&function);
+    append_mixed_arguments(mixed);
+    CHECK(mixed.blocks().size() == 132u);
+    mixed.move_argument_data();
+    CHECK(load_value<uint4>(mixed.argument_data(), 0u).x == 23u);
+    CHECK(mixed.ptr().size() == 132u);
+    CHECK(mixed.argument_data().size() ==
+          mem_offset(structure_size(mixed.blocks()), alignof(uint3)) + sizeof(uint3));
+    for (size_t i = 0u, offset = 0u; i < mixed.blocks().size(); ++i) {
+        const auto &block = mixed.blocks()[i];
+        offset = mem_offset(offset, block.alignment);
+        CHECK(std::memcmp(mixed.argument_data().data() + offset, block.address, block.size) == 0);
+        offset += block.size;
+    }
+    ShaderArgumentPack overflow(&function);
+    for (uint i = 0u; i < 257u; ++i) overflow << make_float4(float(i));
+    overflow.move_argument_data();
+    CHECK(load_value<float4>(overflow.argument_data(), 0u).x == 0.f);
+    CHECK(load_value<float4>(overflow.argument_data(), 256u * sizeof(float4)).x == 256.f);
+    return true;
+}
+
+[[nodiscard]] bool test_warm_metadata_then_new_kernel() {
+    Function warm_function(Function::Tag::KERNEL);
+    PackMetadataRecord value{};
+    for (uint i = 0u; i < 2u; ++i) {
+        ShaderArgumentPack pack(&warm_function);
+        pack << value;
+        pack.move_argument_data();
+    }
+    Kernel kernel = [](Var<PackMetadataRecord> record) {
+        Var<PackMetadataLeaf> leaf = record.leaf;
+        Float sum = leaf.value.x + record.coordinates[0u].x;
+        sum = sum + leaf.tag.cast<float>();
+    };
+    const Type *leaf = Type::of<PackMetadataLeaf>(), *record = Type::of<PackMetadataRecord>();
+    bool found_leaf = false, found_record = false;
+    kernel.function()->for_each_structure([&](const Type *type) {
+        found_leaf |= type == leaf;
+        found_record |= type == record;
+    });
+    CHECK(found_leaf && found_record);
+    CHECK(leaf->members().size() == 2u && record->members().size() == 2u);
+    CHECK(leaf->members()[0u] == Type::of<float4>() && leaf->members()[1u] == Type::of<uint>());
+    CHECK(record->members()[0u] == leaf && record->members()[1u] == Type::of<std::array<float2, 2u>>());
+    return true;
+}
+
+template<PrecisionPolicy Policy>
+[[nodiscard]] bool test_real_storage_policy() {
+    Function function(Function::Tag::KERNEL);
+    function.set_storage_policy({.policy = Policy, .allow_real_in_storage = false});
+    ShaderArgumentPack pack(&function);
+    real scalar{1.5f};
+    Vector<real, 2u> vector{real{2.25f}, real{3.5f}};
+    pack << scalar << vector;
+    pack.move_argument_data();
+    const auto expected_scalar = to_storage_value<Policy>(scalar);
+    const auto expected_vector = to_storage_value<Policy>(vector);
+    CHECK(pack.blocks().size() == 2u);
+    CHECK(pack.blocks()[0u].size == sizeof(expected_scalar) && pack.blocks()[1u].size == sizeof(expected_vector));
+    CHECK(std::memcmp(pack.argument_data().data(), &expected_scalar, sizeof(expected_scalar)) == 0);
+    const size_t vector_offset = mem_offset(sizeof(expected_scalar), alignof(decltype(expected_vector)));
+    CHECK(std::memcmp(pack.argument_data().data() + vector_offset, &expected_vector, sizeof(expected_vector)) == 0);
+    return true;
+}
