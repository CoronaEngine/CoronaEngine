+void benchmark_argument_pack() {
+    Function function(Function::Tag::KERNEL);
+    static const BufferDesc<> descriptor{};
+    auto measure = [&](const char *name, auto encode) {
+        uint64_t checksum = 0u;
+        for (uint warmup = 0u; warmup < 64u; ++warmup) {
+            auto pack = make_shared<ShaderArgumentPack>(&function);
+            encode(*pack); pack->move_argument_data();
+        }
+        const auto start = std::chrono::steady_clock::now();
+        for (uint iteration = 0u; iteration < 10000u; ++iteration) {
+            auto pack = make_shared<ShaderArgumentPack>(&function);
+            encode(*pack); pack->move_argument_data();
+            checksum += load_value<uint>(pack->argument_data(), 0u) + pack->argument_data().size();
+        }
+        const double milliseconds = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - start).count();
+        std::cout << "argument_pack_cpu case=" << name << " packs=10000 object_bytes="
+                  << sizeof(ShaderArgumentPack) << " elapsed_ms=" << milliseconds
+                  << " ns_per_pack=" << milliseconds * 100.f << " checksum=" << checksum << '\n';
+    };
+    measure("mixed_reblur_shape", append_mixed_arguments);
+    // Equal block count; direct buffer descriptors never use POD overflow storage.
+    measure("buffer_only_negative", [&](ShaderArgumentPack &pack) {
+        for (uint i = 0u; i < 132u; ++i) pack << descriptor;
+    });
+}
