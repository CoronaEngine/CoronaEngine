include_guard(GLOBAL)

# Horizon deliberately supplies a static runtime. Vision has several DLLs, so
# Engine owns one shared copy and gives staged patches only a private registry.
function(corona_configure_hotfix_runtime horizon_source)
    if(TARGET corona-hotfix-runtime)
        return()
    endif()
    get_filename_component(engine_source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
    include("${horizon_source}/build_tools/cmake/horizon_hotfix_manifest.cmake")
    find_package(Threads REQUIRED)
    # These upstream static helpers are embedded in Engine's shared owner.
    foreach(helper horizon-hotfix-build-cmake horizon-hotfix-process-windows
            horizon-hotfix-process-posix horizon-logging)
        if(TARGET "${helper}")
            get_target_property(type "${helper}" TYPE)
            if(type STREQUAL "STATIC_LIBRARY")
                set_property(TARGET "${helper}" PROPERTY POSITION_INDEPENDENT_CODE ON)
            endif()
        endif()
    endforeach()
    set(runtime_sources)
    foreach(source build_system file_tool hotfix module_interface staged_module)
        list(APPEND runtime_sources "${horizon_source}/src/hotfix/${source}.cpp")
    endforeach()
    add_library(corona-hotfix-runtime SHARED ${runtime_sources}
        "${engine_source}/vision/src/hotfix_runtime/engine_hotfix.cpp")
    add_custom_target(corona-hotfix-snapshots)
    target_link_libraries(corona-hotfix-runtime PUBLIC horizon-hotfix-runtime-api
        PRIVATE horizon-hotfix-build-cmake horizon-logging Threads::Threads ${CMAKE_DL_LIBS})
    if(WIN32)
        target_link_libraries(corona-hotfix-runtime PRIVATE horizon-hotfix-process-windows)
    else()
        target_link_libraries(corona-hotfix-runtime PRIVATE horizon-hotfix-process-posix)
    endif()
    target_compile_definitions(corona-hotfix-runtime PRIVATE CORONA_HOTFIX_EXPORTS=1)
    target_include_directories(corona-hotfix-runtime PUBLIC "${engine_source}/vision/src"
        PRIVATE "${CMAKE_BINARY_DIR}/generated/hotfix/$<CONFIG>")
    set_target_properties(corona-hotfix-runtime PROPERTIES
        WINDOWS_EXPORT_ALL_SYMBOLS ON POSITION_INDEPENDENT_CODE ON
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
    if(MSVC)
        target_compile_options(corona-hotfix-runtime PRIVATE /utf-8)
    endif()
    # Capture the selected compiler environment, so launching Engine outside a
    # developer shell does not change the compiler used by its background build.
    set(environment_entries "")
    foreach(key PATH INCLUDE LIB LIBPATH SDKROOT)
        if(DEFINED ENV{${key}})
            string(APPEND environment_entries "    {\"${key}\", R\"corona($ENV{${key}})corona\"},\n")
        endif()
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/generated/hotfix/$<CONFIG>/engine_hotfix_config.h"
        CONTENT "#pragma once\n#include <map>\n#include <string>\nnamespace Corona::Hotfix::Configuration {\ninline constexpr auto build_directory = u8R\"corona(${CMAKE_BINARY_DIR})corona\";\ninline constexpr auto cmake = u8R\"corona(${CMAKE_COMMAND})corona\";\ninline constexpr auto configuration = \"$<CONFIG>\";\ninline std::map<std::string, std::string> environment() { return {\n${environment_entries}}; }\n}\n")
endfunction()

# Snapshot build products after a normal build. Intentionally no BYPRODUCTS:
# a patch must not discover a producer edge back to a loaded original DLL.
function(_corona_hotfix_snapshot target output)
    if(NOT TARGET "${target}")
        set(${output} "${target}" PARENT_SCOPE)
        return()
    endif()
    get_target_property(alias "${target}" ALIASED_TARGET)
    if(alias)
        set(target "${alias}")
    endif()
    get_target_property(imported "${target}" IMPORTED)
    if(imported)
        set(${output} "${target}" PARENT_SCOPE)
        return()
    endif()
    string(REPLACE "::" "-" snapshot "corona-hotfix-link-${target}")
    set(${output} "${snapshot}" PARENT_SCOPE)
    if(TARGET "${snapshot}")
        return()
    endif()
    get_target_property(type "${target}" TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY")
        add_library("${snapshot}" INTERFACE IMPORTED GLOBAL)
    elseif(type MATCHES "^(STATIC|SHARED|MODULE)_LIBRARY$")
        if(type STREQUAL "STATIC_LIBRARY")
            add_library("${snapshot}" STATIC IMPORTED GLOBAL)
            set(suffix "${CMAKE_STATIC_LIBRARY_SUFFIX}")
        else()
            add_library("${snapshot}" SHARED IMPORTED GLOBAL)
            set(suffix "${CMAKE_SHARED_LIBRARY_SUFFIX}")
        endif()
        set(directory "${CMAKE_BINARY_DIR}/hotfix-link")
        if(CMAKE_CONFIGURATION_TYPES)
            set(configurations ${CMAKE_CONFIGURATION_TYPES})
        else()
            set(configurations "${CMAKE_BUILD_TYPE}")
        endif()
        foreach(config IN LISTS configurations)
            string(TOUPPER "${config}" config_upper)
            set_property(TARGET "${snapshot}" APPEND PROPERTY IMPORTED_CONFIGURATIONS "${config}")
            set_property(TARGET "${snapshot}" PROPERTY "IMPORTED_LOCATION_${config_upper}"
                "${directory}/${config}/${target}${suffix}")
            if(WIN32 AND NOT type STREQUAL "STATIC_LIBRARY")
                set_property(TARGET "${snapshot}" PROPERTY "IMPORTED_IMPLIB_${config_upper}"
                    "${directory}/${config}/${target}${CMAKE_IMPORT_LIBRARY_SUFFIX}")
            endif()
        endforeach()
        set(copy_commands
            COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory}/$<CONFIG>"
            COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:${target}>"
                "${directory}/$<CONFIG>/${target}${suffix}")
        if(WIN32 AND NOT type STREQUAL "STATIC_LIBRARY")
            list(APPEND copy_commands
                COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_LINKER_FILE:${target}>"
                    "${directory}/$<CONFIG>/${target}${CMAKE_IMPORT_LIBRARY_SUFFIX}")
        endif()
        # TARGET POST_BUILD cannot attach across CMake directories. This normal
        # executable prerequisite runs after the original library instead, with
        # no file-producing edge visible to a hotfix build.
        add_custom_target("${snapshot}-copy" ${copy_commands} DEPENDS "${target}" VERBATIM)
        add_dependencies(corona-hotfix-snapshots "${snapshot}-copy")
    else()
        message(FATAL_ERROR "Unsupported hotfix dependency: ${target} (${type})")
    endif()
    foreach(property INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
            INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_FEATURES
            INTERFACE_LINK_OPTIONS INTERFACE_LINK_DIRECTORIES)
        get_target_property(value "${target}" "${property}")
        if(value)
            set_property(TARGET "${snapshot}" PROPERTY "${property}" "${value}")
        endif()
    endforeach()
    get_target_property(links "${target}" INTERFACE_LINK_LIBRARIES)
    if(links)
        _corona_hotfix_snapshot_links(mapped ${links})
        set_property(TARGET "${snapshot}" PROPERTY INTERFACE_LINK_LIBRARIES "${mapped}")
    endif()
endfunction()

function(_corona_hotfix_snapshot_links output)
    set(result)
    foreach(link IN LISTS ARGN)
        # CMake's directory-id markers are irrelevant for GLOBAL imported copies.
        if(link MATCHES "^::@")
            continue()
        endif()
        if(TARGET "${link}")
            _corona_hotfix_snapshot("${link}" link)
        elseif(link MATCHES "^[$]<")
            # Preserve conditional link expressions while replacing their target
            # operands, including LINK_ONLY and TARGET_NAME_IF_EXISTS wrappers.
            string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_.:+-]*" tokens "${link}")
            foreach(token IN LISTS tokens)
                string(REGEX REPLACE "^.*:" "" tail "${token}")
                if(TARGET "${token}")
                    set(dependency "${token}")
                elseif(TARGET "${tail}")
                    set(dependency "${tail}")
                else()
                    continue()
                endif()
                _corona_hotfix_snapshot("${dependency}" replacement)
                string(REPLACE ":${dependency}>" ":${replacement}>" link "${link}")
                string(REPLACE ":${dependency}," ":${replacement}," link "${link}")
            endforeach()
        endif()
        list(APPEND result "${link}")
    endforeach()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(corona_add_hotfix_patch target)
    cmake_parse_arguments(PATCH "" "" "SOURCES;LINK_LIBRARIES" ${ARGN})
    if(NOT PATCH_SOURCES)
        get_target_property(PATCH_SOURCES "${target}" SOURCES)
    endif()
    get_target_property(source_directory "${target}" SOURCE_DIR)
    set(sources)
    foreach(source IN LISTS PATCH_SOURCES)
        if(source MATCHES "[.]cpp$")
            get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${source_directory}")
            list(APPEND sources "${source}")
        endif()
    endforeach()
    if(NOT sources)
        message(FATAL_ERROR "Hotfix target ${target} has no C++ sources")
    endif()
    set(patch "${target}-hotfix")
    add_library("${patch}" MODULE EXCLUDE_FROM_ALL ${sources})
    horizon_register_hotfix_module("${patch}")
    set_target_properties("${patch}" PROPERTIES
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/hotfix-modules/$<CONFIG>"
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/hotfix-modules/$<CONFIG>"
        PREFIX "" DEBUG_POSTFIX "" UNITY_BUILD OFF)
    foreach(property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FEATURES)
        get_target_property(value "${target}" "${property}")
        if(value)
            set_property(TARGET "${patch}" APPEND PROPERTY "${property}" "${value}")
        endif()
    endforeach()
    foreach(property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS)
        get_property(value DIRECTORY "${source_directory}" PROPERTY "${property}")
        if(value)
            set_property(TARGET "${patch}" APPEND PROPERTY "${property}" "${value}")
        endif()
    endforeach()
    if(PATCH_LINK_LIBRARIES)
        set(links ${PATCH_LINK_LIBRARIES})
    else()
        get_target_property(links "${target}" LINK_LIBRARIES)
    endif()
    set_property(TARGET "${patch}" PROPERTY CORONA_HOTFIX_LINK_LIBRARIES "${links};corona-hotfix-runtime")
    set_property(GLOBAL APPEND PROPERTY CORONA_HOTFIX_PATCH_TARGETS "${patch}")

    # Upstream accepts one file or directory per target, and ignores subsequent
    # additions. Watch the common directory once for multi-source modules.
    list(LENGTH sources source_count)
    list(GET sources 0 watch)
    if(source_count GREATER 1)
        get_filename_component(watch "${watch}" DIRECTORY)
        foreach(source IN LISTS sources)
            cmake_path(IS_PREFIX watch "${source}" NORMALIZE below_watch)
            while(NOT below_watch)
                get_filename_component(watch "${watch}" DIRECTORY)
                cmake_path(IS_PREFIX watch "${source}" NORMALIZE below_watch)
            endwhile()
        endforeach()
    endif()
    get_target_property(binary_directory "${target}" BINARY_DIR)
    # Keep generated object paths short on Windows, including helpers found
    # while finalizing from the root directory.
    string(SHA256 watch_id "${target}")
    string(SUBSTRING "${watch_id}" 0 8 watch_id)
    set(registrar "${binary_directory}/hf-${watch_id}.cpp")
    file(CONFIGURE OUTPUT "${registrar}" CONTENT "#include \"hotfix_runtime/engine_hotfix.h\"\nnamespace {\nstruct Watch { Watch() { Corona::Hotfix::register_target(u8R\"corona(${watch})corona\", \"${patch}\"); } };\nWatch watch;\n}\n")
    if(MSVC)
        set_source_files_properties("${registrar}" PROPERTIES COMPILE_OPTIONS /utf-8)
    endif()
    target_sources("${target}" PRIVATE "${registrar}")
    target_link_libraries("${target}" PRIVATE corona-hotfix-runtime)
endfunction()

function(corona_finalize_hotfix)
    # Some registered constructors live in shared helper libraries rather than
    # vision_add_plugin modules (for example ReSTIR and adaptive inspectors).
    set(directories "${CMAKE_SOURCE_DIR}")
    while(directories)
        list(POP_FRONT directories directory)
        get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
        list(APPEND directories ${children})
        get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(target IN LISTS targets)
            get_target_property(type "${target}" TYPE)
            if(NOT target MATCHES "^vision-" OR NOT type STREQUAL "SHARED_LIBRARY" OR TARGET "${target}-hotfix")
                continue()
            endif()
            get_target_property(sources "${target}" SOURCES)
            foreach(source IN LISTS sources)
                if(NOT source MATCHES "[.]cpp$")
                    continue()
                endif()
                get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${directory}")
                if(EXISTS "${source}")
                    file(READ "${source}" source_text)
                    if(source_text MATCHES "VS_(REGISTER_HOTFIX|MAKE_CLASS_CREATOR_HOTFIX)")
                        corona_add_hotfix_patch("${target}")
                        break()
                    endif()
                endif()
            endforeach()
        endforeach()
    endwhile()
    get_property(patches GLOBAL PROPERTY CORONA_HOTFIX_PATCH_TARGETS)
    foreach(patch IN LISTS patches)
        get_target_property(links "${patch}" CORONA_HOTFIX_LINK_LIBRARIES)
        _corona_hotfix_snapshot_links(mapped ${links})
        target_link_libraries("${patch}" PRIVATE ${mapped})
    endforeach()
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _corona_attach_hotfix_snapshots)
endfunction()

function(_corona_target_uses_hotfix target output)
    set(${output} FALSE PARENT_SCOPE)
    set(pending "${target}")
    set(checked)
    # Public dependencies can appear in both link properties and in many
    # diamonds. Visit each canonical target once instead of enumerating every
    # path. This local traversal also handles cycles without caching a false
    # answer before their other branches have been explored.
    while(pending)
        list(POP_FRONT pending current)
        while(current MATCHES "^[$]<LINK_ONLY:(.*)>$")
            set(current "${CMAKE_MATCH_1}")
        endwhile()
        if(NOT TARGET "${current}")
            continue()
        endif()
        get_target_property(alias "${current}" ALIASED_TARGET)
        if(alias)
            set(current "${alias}")
        endif()
        if(current STREQUAL "corona-hotfix-runtime")
            set(${output} TRUE PARENT_SCOPE)
            return()
        endif()
        if(current IN_LIST checked)
            continue()
        endif()
        list(APPEND checked "${current}")
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(links "${current}" "${property}")
            if(links)
                list(APPEND pending ${links})
            endif()
        endforeach()
    endwhile()
endfunction()

function(_corona_attach_hotfix_snapshots)
    set(directories "${CMAKE_SOURCE_DIR}")
    while(directories)
        list(POP_FRONT directories directory)
        get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
        list(APPEND directories ${children})
        get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach(target IN LISTS targets)
            get_target_property(type "${target}" TYPE)
            if(type STREQUAL "EXECUTABLE")
                _corona_target_uses_hotfix("${target}" uses_hotfix)
                if(uses_hotfix)
                    add_dependencies("${target}" corona-hotfix-snapshots)
                endif()
            endif()
        endforeach()
    endwhile()
endfunction()
