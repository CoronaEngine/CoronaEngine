{
  "name": "cabbageui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "test:unit": "node --test tests/js",
    "format": "prettier --write \"src/**/*.{js,vue,css,html}\" \"tests/js/**/*.{js,mjs,vue,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,html}\" \"tests/js/**/*.{js,mjs,vue,css,html}\"",
    "lint": "eslint \"src/**/*.{js,vue}\" \"tests/js/**/*.{js,mjs,vue}\"",
    "i18n:check": "node scripts/check-i18n.mjs",
    "lint:fix": "eslint --fix \"src/**/*.{js,vue}\" \"tests/js/**/*.{js,mjs,vue}\""
  },
  "dependencies": {
    "blockly": "^13.0.0",
    "cssesc": "^3.0.0",
    "gsap": "^3.15.0",
    "pinia": "^3.0.4",
    "postcss-selector-parser": "^6.1.4",
    "three": "^0.185.1",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^6.0.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.5.3",
    "prettier": "^3.4.2",
    "sass": "^1.85.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
