.vscode/
.idea/
.vs/
.venv/
.claude/
.agents/
.superpowers/
codex.md
AGENTS.md
implementation.md
TaskSplitting.md

# Tool caches
**/.cache/
__pycache__/

# third-party libraries (manually added)
#
# Python-3.13.7 故意不在下方白名单中：其基础 CPython 文件已在索引内
# （已跟踪文件不受 ignore 约束），而 pip 装进 Lib/site-packages 的 ~2G
# editor 依赖需要保持被忽略。若为它添加 ! 白名单，会让这些依赖全部
# 出现在 git status 里。新增基础 CPython 文件需 git add -f。
#
# tbb 曾在此白名单中，现已移除：TBB 统一由 Conan 提供
# （conanfile.py 的 onetbb 依赖），misc/cmake/corona_tbb.cmake 要求
# TBB::tbb 目标且无本地目录回退。
/third_party/*
!/third_party/node-v22.19.0-win-x64/
!/third_party/node-v22.19.0-win-x64/**

# Log files
*.log
.codex/

# CodeGraph (本地代码索引工具产物 + 含机器绝对路径，仅本地使用)
.codegraph/
.mcp.json

# Thoth local dashboard/runtime cache
/research.db
/research.db-*
/.tmp/
/temp/
/.pytest_cache/
/.pre-commit-config.yaml
/scripts/
/tests/test_structure.py
/tools/dashboard/
*.py[cod]

# 密钥文件 —— 严禁提交
**/ai_setting.py
**/ai_setting.*
