find_package(assimp CONFIG REQUIRED)
find_package(stb CONFIG REQUIRED)
find_package(nanobind CONFIG REQUIRED)
find_package(SDL3 CONFIG REQUIRED)
find_package(enet CONFIG REQUIRED)
find_package(TBB CONFIG REQUIRED)
find_package(miniaudio CONFIG REQUIRED)
find_package(nlohmann_json CONFIG REQUIRED)
find_package(tinyexr CONFIG REQUIRED)
find_package(meshoptimizer CONFIG REQUIRED)
find_package(astc-encoder CONFIG REQUIRED)
find_package(ffmpeg CONFIG REQUIRED)
find_package(quill CONFIG REQUIRED)

include(corona_horizon_workspace)
corona_add_horizon_workspace()

corona_require_target(Horizon "Horizon")
corona_require_target(ktm::ktm "ktm")
corona_require_target(assimp::assimp "assimp")
corona_require_target(SDL3::SDL3 "SDL3")
corona_require_target(TBB::tbb "TBB")
corona_require_target(nlohmann_json::nlohmann_json "nlohmann_json")
corona_require_target(astcenc-native-static "astc-encoder")

if(NOT TARGET SDL3::SDL3-static AND TARGET SDL3::SDL3)
    add_library(SDL3::SDL3-static ALIAS SDL3::SDL3)
endif()

if(NOT TARGET assimp)
    corona_make_interface_target(assimp assimp::assimp)
endif()

if(NOT TARGET nlohmann_json)
    corona_make_interface_target(nlohmann_json nlohmann_json::nlohmann_json)
endif()

if(NOT TARGET enet)
    if(TARGET enet::enet)
        corona_make_interface_target(enet enet::enet)
    else()
        message(FATAL_ERROR "[3rdparty] Expected enet::enet or enet target from package 'enet'")
    endif()
endif()

if(NOT TARGET meshoptimizer)
    if(TARGET meshoptimizer::meshoptimizer)
        corona_make_interface_target(meshoptimizer meshoptimizer::meshoptimizer)
    else()
        message(FATAL_ERROR "[3rdparty] Expected meshoptimizer::meshoptimizer target")
    endif()
endif()

if(NOT TARGET stb_headers)
    add_library(stb_headers INTERFACE)
    if(TARGET stb::stb)
        target_link_libraries(stb_headers INTERFACE stb::stb)
    elseif(DEFINED stb_INCLUDE_DIRS)
        target_include_directories(stb_headers INTERFACE ${stb_INCLUDE_DIRS})
        target_compile_definitions(stb_headers INTERFACE ${stb_DEFINITIONS})
    else()
        message(FATAL_ERROR "[3rdparty] Could not derive include dirs for package 'stb'")
    endif()
endif()

if(NOT TARGET miniaudio_headers)
    add_library(miniaudio_headers INTERFACE)
    if(TARGET miniaudio::miniaudio)
        target_link_libraries(miniaudio_headers INTERFACE miniaudio::miniaudio)
    elseif(DEFINED miniaudio_INCLUDE_DIRS)
        target_include_directories(miniaudio_headers INTERFACE ${miniaudio_INCLUDE_DIRS})
        target_compile_definitions(miniaudio_headers INTERFACE ${miniaudio_DEFINITIONS})
    else()
        message(FATAL_ERROR "[3rdparty] Could not derive include dirs for package 'miniaudio'")
    endif()
endif()

if(NOT TARGET tinyexr_headers)
    add_library(tinyexr_headers INTERFACE)
    if(TARGET tinyexr::tinyexr)
        target_link_libraries(tinyexr_headers INTERFACE tinyexr::tinyexr)
    elseif(DEFINED tinyexr_INCLUDE_DIRS)
        target_include_directories(tinyexr_headers INTERFACE ${tinyexr_INCLUDE_DIRS})
        target_compile_definitions(tinyexr_headers INTERFACE ${tinyexr_DEFINITIONS})
    else()
        message(FATAL_ERROR "[3rdparty] Could not derive include dirs for package 'tinyexr'")
    endif()
endif()

if(CORONA_BUILD_VISION)
    find_package(cxxopts CONFIG REQUIRED)
    find_package(glfw3 CONFIG REQUIRED)
    corona_require_target(ocarina "Horizon")
    corona_require_target(ocarina-include "Horizon")
    corona_require_target(ocarina-core "Horizon")
    corona_require_target(horizon-hotfix "Horizon")
    corona_require_target(horizon::fmt "Horizon")
    corona_require_target(horizon::spdlog "Horizon")
    corona_require_target(horizon::xxhash "Horizon")

    if(NOT TARGET cxxopts AND TARGET cxxopts::cxxopts)
        corona_make_interface_target(cxxopts cxxopts::cxxopts)
    endif()

    if(NOT TARGET glfw)
        if(TARGET glfw)
            # Already available from package config.
        elseif(TARGET glfw::glfw)
            corona_make_interface_target(glfw glfw::glfw)
        elseif(TARGET glfw3::glfw)
            corona_make_interface_target(glfw glfw3::glfw)
        else()
            message(FATAL_ERROR "[3rdparty] Expected glfw target from package 'glfw'")
        endif()
    endif()

    if(VISION_BUILD_OIDN)
        find_package(OpenImageDenoise CONFIG REQUIRED)
    endif()
endif()

if(MSVC)
    foreach(_corona_charset_target Helicon Horizon)
        corona_strip_msvc_charset_interface(${_corona_charset_target})
    endforeach()
endif()

message(STATUS "[3rdparty] Conan package targets loaded")
