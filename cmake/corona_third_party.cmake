# ==============================================================================
# corona_third_party.cmake
#
# Conan owns dependency resolution. This file only consumes CMake package files
# generated by Conan and recreates the local compatibility targets used by the
# existing CoronaEngine CMake graph.
# ==============================================================================

include_guard(GLOBAL)

function(corona_require_target target_name package_name)
    if(NOT TARGET ${target_name})
        message(FATAL_ERROR "[3rdparty] Expected target '${target_name}' from package '${package_name}'")
    endif()
endfunction()

function(corona_make_interface_target target_name)
    if(TARGET ${target_name})
        return()
    endif()

    add_library(${target_name} INTERFACE)
    target_link_libraries(${target_name} INTERFACE ${ARGN})
endfunction()

function(corona_strip_msvc_charset_interface target_name)
    if(NOT MSVC OR NOT TARGET ${target_name})
        return()
    endif()

    set(_corona_legacy_charset_regex "/(source|execution)-charset:utf-8")
    set(_corona_stripped FALSE)
    foreach(_corona_property COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS)
        get_target_property(_corona_options ${target_name} ${_corona_property})
        if(NOT _corona_options)
            continue()
        endif()
        set(_corona_options_kept "")
        foreach(_opt IN LISTS _corona_options)
            if(_opt MATCHES "${_corona_legacy_charset_regex}")
                set(_corona_stripped TRUE)
            else()
                list(APPEND _corona_options_kept "${_opt}")
            endif()
        endforeach()
        set_property(TARGET ${target_name} PROPERTY ${_corona_property} "${_corona_options_kept}")
    endforeach()
    if(_corona_stripped)
        message(STATUS "[3rdparty] Normalized MSVC charset flags on ${target_name}")
    endif()
endfunction()

